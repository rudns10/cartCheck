<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MartCart.AppFaithful.Pages.SplashPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00A968" Offset="0"/>
            <GradientStop Color="#00D080" Offset="0.55"/>
            <GradientStop Color="#4ADE80" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <!-- Decorative circles -->
        <Ellipse Fill="White" Opacity="0.06" WidthRequest="240" HeightRequest="240"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-80,-80,0"/>
        <Ellipse Fill="White" Opacity="0.05" WidthRequest="160" HeightRequest="160"
                 HorizontalOptions="Start" VerticalOptions="End" Margin="-40,0,0,120"/>

        <!-- Center content -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="18">

            <!-- Logo mark -->
            <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 24"
                    Stroke="Transparent" HorizontalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#F0FDF4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#00A968" Offset="0,8" Radius="20" Opacity="0.4"/>
                </Border.Shadow>
                <Grid WidthRequest="96" HeightRequest="96">
                    <Path Stroke="#2EBE6B" StrokeThickness="7" StrokeLineCap="Round" StrokeLineJoin="Round"
                          Data="M 23.2 33.7 L 33.3 33.7 L 37.9 64.3 L 73.7 64.3 L 76.8 41.1 L 39.6 41.1"/>
                    <Ellipse Fill="#2EBE6B" WidthRequest="9.2" HeightRequest="9.2" HorizontalOptions="Start" VerticalOptions="Start" Margin="39.2,70.2,0,0"/>
                    <Ellipse Fill="#2EBE6B" WidthRequest="9.2" HeightRequest="9.2" HorizontalOptions="Start" VerticalOptions="Start" Margin="64.5,70.2,0,0"/>
                    <Ellipse Fill="#2EBE6B" WidthRequest="32.8" HeightRequest="32.8" HorizontalOptions="Start" VerticalOptions="Start" Margin="47.9,21.5,0,0"/>
                    <Path Stroke="White" StrokeThickness="4.6" StrokeLineCap="Round" StrokeLineJoin="Round"
                          Data="M 55.8 39.0 L 62.1 45.3 L 73.7 31.6"/>
                </Grid>
            </Border>

            <!-- Brand name -->
            <Label Text="CartCheck" FontSize="36" FontAttributes="Bold" TextColor="White"
                   HorizontalTextAlignment="Center" Margin="0,8,0,0"/>

            <!-- Tagline pill -->
            <Border Background="#33FFFFFF" Stroke="Transparent"
                    StrokeShape="RoundRectangle 99" Padding="14,6" HorizontalOptions="Center">
                <Label Text="오늘의 카트" FontSize="13" FontAttributes="Bold"
                       TextColor="White" CharacterSpacing="0.5"/>
            </Border>

            <!-- Slogan -->
            <Label Text="정상가로 추적하고, 할인가로 결제하세요"
                   FontSize="12" TextColor="White" Opacity="0.9"
                   HorizontalTextAlignment="Center" Margin="0,4,0,0"/>

        </VerticalStackLayout>

        <!-- Bottom indicator -->
        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,52">
            <ActivityIndicator IsRunning="True" Color="White" Opacity="0.7" WidthRequest="22" HeightRequest="22"/>
            <Label Text="v0.1.0" FontSize="10" TextColor="White" Opacity="0.6"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
