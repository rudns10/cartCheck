<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MartCart.AppFaithful.Controls"
             x:Class="MartCart.AppFaithful.Pages.HistoryPage"
             BackgroundColor="{StaticResource BgColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Padding="20,18,20,12">
            <Label Text="기록" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextColor}"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="0,0,0,24">
            <VerticalStackLayout Spacing="0">

                <!-- Period summary -->
                <Border Margin="16,8,16,0" Background="{StaticResource HeroBrush}" Stroke="Transparent" StrokeShape="RoundRectangle 20" Padding="22">
                    <Border.Shadow>
                        <Shadow Brush="#0A1F33" Offset="0,6" Radius="14" Opacity="0.10"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">
                        <Label x:Name="PeriodTitleLabel" Text="이번 달 실 구매 합계" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource MutedColor}"/>
                        <HorizontalStackLayout Spacing="3" Margin="0,6,0,0">
                            <Label x:Name="SpentTotalLabel" Text="0" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource TextColor}" LineHeight="1"/>
                            <Label Text="원" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" VerticalOptions="End" Margin="0,0,0,5"/>
                        </HorizontalStackLayout>

                        <BoxView Color="{StaticResource DividerSoftColor}" HeightRequest="1" Margin="0,14,0,12"/>

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="CountLabel" Text="0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextColor}"/>
                                <Label Text="장보기 횟수" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="AvgLabel" Text="0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextColor}"/>
                                <Label Text="평균 객단가 (원)" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label x:Name="SavedTotalLabel" Text="0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource AccentColor}"/>
                                <Label Text="절약액 (원)" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Empty state -->
                <Border x:Name="EmptyPanel" Margin="16,18,16,0" Background="{StaticResource SurfaceColor}" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="24,32" IsVisible="False">
                    <Border.Shadow>
                        <Shadow Brush="#0A1F33" Offset="0,2" Radius="6" Opacity="0.06"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="📋" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="아직 기록이 없어요" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}" HorizontalTextAlignment="Center"/>
                        <Label Text="장보기를 끝마치면 여기에 쌓입니다" FontSize="11" TextColor="{StaticResource MutedColor}" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Dynamic cart list -->
                <VerticalStackLayout x:Name="ListContainer" Margin="0,12,0,0" Spacing="10"/>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="2" Active="history"/>

    </Grid>

</ContentPage>
