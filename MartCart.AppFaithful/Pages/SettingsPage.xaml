<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MartCart.AppFaithful.Controls"
             x:Class="MartCart.AppFaithful.Pages.SettingsPage"
             BackgroundColor="{StaticResource BgColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== Top bar ===== -->
        <Grid Grid.Row="0" Padding="20,18,20,12">
            <Label Text="설정" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextColor}"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="0,0,0,24">
            <VerticalStackLayout Spacing="0">

                <!-- ===== Profile card (deep navy gradient) ===== -->
                <Border Margin="16,8,16,4" Background="{StaticResource PrimaryBrush}" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="20,18">
                    <Border.Shadow>
                        <Shadow Brush="#0F2A50" Offset="0,8" Radius="16" Opacity="0.28"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Stroke="Transparent" Background="#2EFFFFFF" StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48">
                            <Label Text="👤" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label x:Name="UserNameLabel" Text="로컬 사용자" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                            <Label x:Name="UserSinceLabel" Text="" FontSize="11" TextColor="White" Opacity="0.8"/>
                            <HorizontalStackLayout Spacing="18" Margin="0,6,0,0">
                                <Label FontSize="11" FontAttributes="Bold" TextColor="White" Opacity="0.9">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="총 "/>
                                            <Span x:Name="UserCartCountSpan" Text="0" TextColor="{StaticResource Accent2Color}"/>
                                            <Span Text="회 장보기"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="11" FontAttributes="Bold" TextColor="White" Opacity="0.9">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="누적 절약 "/>
                                            <Span x:Name="UserSavedSpan" Text="0원" TextColor="{StaticResource Accent2Color}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ============================================= -->
                <!-- 보안 -->
                <!-- ============================================= -->
                <Label Text="보안" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" CharacterSpacing="0.4" Margin="24,18,24,8"/>
                <Border Margin="16,0" Background="{StaticResource SurfaceColor}" Stroke="Transparent" StrokeShape="RoundRectangle 14">
                    <Border.Shadow>
                        <Shadow Brush="#0A1F33" Offset="0,2" Radius="6" Opacity="0.06"/>
                    </Border.Shadow>
                    <VerticalStackLayout>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinChangeTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Stroke="Transparent" Background="#EEF2F7" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="🔒" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="PinTitleLabel" Text="PIN 설정" FontSize="14" FontAttributes="Bold"/>
                                <Label x:Name="PinStatusLabel" Text="아직 설정되지 않음 · 탭해서 설정" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Color="{StaticResource DividerSoftColor}" HeightRequest="1"/>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLockTimeTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Stroke="Transparent" Background="#EEF2F7" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="⏱" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="자동 잠금" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="백그라운드 진입 후 일정 시간 경과 시" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" x:Name="LockTimeLabel" Text="5분" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" VerticalOptions="Center"/>
                            <Label Grid.Column="3" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Color="{StaticResource DividerSoftColor}" HeightRequest="1"/>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Border Grid.Column="0" Stroke="Transparent" Background="{StaticResource AccentBg2Color}" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="👁" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="생체 인증" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="지문 / Face ID로 빠른 잠금 해제" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" x:Name="BioToggle" IsToggled="False" OnColor="{StaticResource AccentColor}" VerticalOptions="Center" Toggled="OnBioToggled"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ============================================= -->
                <!-- 화면 -->
                <!-- ============================================= -->
                <Label Text="화면" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" CharacterSpacing="0.4" Margin="24,18,24,8"/>
                <Border Margin="16,0" Background="{StaticResource SurfaceColor}" Stroke="Transparent" StrokeShape="RoundRectangle 14">
                    <Border.Shadow>
                        <Shadow Brush="#0A1F33" Offset="0,2" Radius="6" Opacity="0.06"/>
                    </Border.Shadow>
                    <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThemeTapped"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" Stroke="Transparent" Background="{StaticResource ThumbDefaultColor}" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                            <Label Text="🎨" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="테마" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}"/>
                            <Label Text="라이트 / 다크 / 시스템 설정" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" x:Name="ThemeLabel" Text="시스템 설정" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" VerticalOptions="Center"/>
                        <Label Grid.Column="3" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- ============================================= -->
                <!-- 마트 관리 -->
                <!-- ============================================= -->
                <Label Text="마트 관리" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" CharacterSpacing="0.4" Margin="24,18,24,8"/>
                <Border Margin="16,0" Background="{StaticResource SurfaceColor}" Stroke="Transparent" StrokeShape="RoundRectangle 14">
                    <Border.Shadow>
                        <Shadow Brush="#0A1F33" Offset="0,2" Radius="6" Opacity="0.06"/>
                    </Border.Shadow>
                    <VerticalStackLayout>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMartListTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Stroke="Transparent" Background="#EEF2F7" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="🏪" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="등록된 마트" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="기본 목표 금액 · 할인 금액 관리" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Stroke="Transparent" Background="{StaticResource DividerSoftColor}" StrokeShape="RoundRectangle 99" Padding="8,3" VerticalOptions="Center">
                                <Label x:Name="MartCountLabel" Text="0개" FontSize="10" FontAttributes="Bold"/>
                            </Border>
                            <Label Grid.Column="3" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Color="{StaticResource DividerSoftColor}" HeightRequest="1"/>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMartAddTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Stroke="Transparent" Background="#EEF2F7" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="＋" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource PrimaryColor}"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="마트 추가" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="새 마트와 목표 금액 등록" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ============================================= -->
                <!-- 앱 -->
                <!-- ============================================= -->
                <Label Text="앱" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource MutedColor}" CharacterSpacing="0.4" Margin="24,18,24,8"/>
                <Border Margin="16,0" Background="{StaticResource SurfaceColor}" Stroke="Transparent" StrokeShape="RoundRectangle 14">
                    <Border.Shadow>
                        <Shadow Brush="#0A1F33" Offset="0,2" Radius="6" Opacity="0.06"/>
                    </Border.Shadow>
                    <VerticalStackLayout>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Stroke="Transparent" Background="#EEF2F7" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="🛡" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="개인정보 처리방침" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="오프라인 우선 · 데이터는 기기에만" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Color="{StaticResource DividerSoftColor}" HeightRequest="1"/>

                        <Grid Padding="18,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinimumHeightRequest="54">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteAllTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Stroke="Transparent" Background="{StaticResource DangerBgColor}" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="🗑" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="모든 데이터 삭제" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource DangerColor}"/>
                                <Label Text="장바구니 · 마트 · 설정 모두 영구 삭제됩니다" FontSize="11" TextColor="{StaticResource MutedColor}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="14" TextColor="{StaticResource Muted2Color}" VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Version footer -->
                <VerticalStackLayout Padding="24,24,24,8" Spacing="4">
                    <Label HorizontalTextAlignment="Center" FontSize="11" TextColor="{StaticResource Muted2Color}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="CartCheck" FontAttributes="Bold" TextColor="{StaticResource MutedColor}"/>
                                <Span Text=" v0.1.0 (build 142)"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="설계 v0.1 · .NET MAUI 9.0" FontSize="11" TextColor="{StaticResource Muted2Color}" HorizontalTextAlignment="Center"/>
                    <Label Text="© 2026 CartCheck · 한국어" FontSize="11" TextColor="{StaticResource Muted2Color}" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="2" Active="settings"/>

    </Grid>

</ContentPage>
