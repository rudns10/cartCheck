<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="MartCart.AppFaithful.Controls.BottomNav">

    <Border Background="{StaticResource SurfaceColor}" Stroke="Transparent"
            StrokeShape="RoundRectangle 0" Padding="0,8,0,14">
        <Border.Shadow>
            <Shadow Brush="#0A1F33" Offset="0,-2" Radius="10" Opacity="0.06"/>
        </Border.Shadow>

        <Grid ColumnDefinitions="*,*,*,*">

            <!-- 홈 -->
            <Border Grid.Column="0" Background="Transparent" Stroke="Transparent" Padding="0,4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="HomePill" Background="Transparent" Stroke="Transparent"
                            StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                        <shapes:Path x:Name="HomeIcon" WidthRequest="24" HeightRequest="24"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M12 3 L4 10 V20 H10 V14 H14 V20 H20 V10 Z"
                              Fill="{StaticResource MutedColor}"/>
                    </Border>
                    <Label x:Name="HomeLabel" Text="홈" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource MutedColor}"
                           HorizontalTextAlignment="Center" LineBreakMode="NoWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- 기록 -->
            <Border Grid.Column="1" Background="Transparent" Stroke="Transparent" Padding="0,4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="HistoryPill" Background="Transparent" Stroke="Transparent"
                            StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                        <shapes:Path x:Name="HistoryIcon" WidthRequest="22" HeightRequest="22"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M13 7 H11 V13 L16 16 L17 14.5 L13 12 Z"
                              Fill="{StaticResource MutedColor}"/>
                    </Border>
                    <Label x:Name="HistoryLabel" Text="기록" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource MutedColor}"
                           HorizontalTextAlignment="Center" LineBreakMode="NoWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- 통계 -->
            <Border Grid.Column="2" Background="Transparent" Stroke="Transparent" Padding="0,4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStatsTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="StatsPill" Background="Transparent" Stroke="Transparent"
                            StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                        <shapes:Path x:Name="StatsIcon" WidthRequest="22" HeightRequest="22"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M4 14 H7 V20 H4 Z M10 9 H13 V20 H10 Z M16 4 H19 V20 H16 Z"
                              Fill="{StaticResource MutedColor}"/>
                    </Border>
                    <Label x:Name="StatsLabel" Text="통계" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource MutedColor}"
                           HorizontalTextAlignment="Center" LineBreakMode="NoWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- 설정 -->
            <Border Grid.Column="3" Background="Transparent" Stroke="Transparent" Padding="0,4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="SettingsPill" Background="Transparent" Stroke="Transparent"
                            StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                        <shapes:Path x:Name="SettingsIcon" WidthRequest="22" HeightRequest="22"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M12 8 C 9.79 8 8 9.79 8 12 C 8 14.21 9.79 16 12 16 C 14.21 16 16 14.21 16 12 C 16 9.79 14.21 8 12 8 Z M19.43 12.97 C 19.47 12.65 19.5 12.33 19.5 12 C 19.5 11.67 19.47 11.34 19.43 11.03 L21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L16.56 6.05 C 16.04 5.66 15.48 5.32 14.87 5.07 L14.5 2.42 C 14.46 2.18 14.25 2 14 2 H10 C 9.75 2 9.54 2.18 9.5 2.42 L9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L4.95 5.05 C 4.72 4.96 4.46 5.05 4.34 5.27 L2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L4.57 11.03 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.65 4.57 12.97 L2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L4.34 18.73 C 4.46 18.95 4.73 19.03 4.95 18.95 L7.44 17.95 C 7.96 18.34 8.52 18.68 9.13 18.93 L9.5 21.58 C 9.54 21.82 9.75 22 10 22 H14 C 14.25 22 14.46 21.82 14.5 21.58 L14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L19.05 18.95 C 19.27 19.04 19.54 18.95 19.66 18.73 L21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 Z"
                              Fill="{StaticResource MutedColor}"/>
                    </Border>
                    <Label x:Name="SettingsLabel" Text="설정" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource MutedColor}"
                           HorizontalTextAlignment="Center" LineBreakMode="NoWrap"/>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Border>

</ContentView>
